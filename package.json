{
  "name": "smartup-marketing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "wrangler dev",
    "dev": "astro dev",
    "build": "npm run build:assets && astro build",
    "build:assets": "esbuild src/assessment/world.js src/assessment/companion.js --bundle --format=esm --minify --outdir=public/assessment",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "check": "node --check server/*.mjs sites/worker.mjs dist/app.js || true",
    "test": "node --test tests/*.test.mjs",
    "pretest": "npm run build",
    "test:e2e": "astro build && playwright test",
    "media": "node scripts/fetch-media.mjs && node scripts/build-media.mjs",
    "fonts": "sh scripts/subset-fonts.sh",
    "setup": "node scripts/setup-local-admin.mjs",
    "content:reset": "node scripts/reset-content.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/node": "11.1.7",
    "astro": "^7.4.0",
    "compression": "1.8.2",
    "cookie": "2.0.1",
    "motion": "14.1.0",
    "sharp": "0.35.5",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.165.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.0",
      "sharp": "^0.35.4"
    }
  }
}
