{
  "name": "smartup-marketing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "astro dev",
    "check": "node --check server.mjs && for f in server/*.mjs sites/worker.mjs scripts/build-sites.mjs dist/app.js dist/assessment/engine.js dist/assessment/assessment.js dist/assessment/admin/admin.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test tests/*.test.mjs",
    "pretest": "astro build && node scripts/build-sites.mjs",
    "test:e2e": "astro build && playwright test",
    "build": "npm run build:assets && astro build && node scripts/build-sites.mjs",
    "build:assets": "esbuild src/assessment/world.js src/assessment/companion.js --bundle --format=esm --minify --outdir=dist/assessment",
    "media": "node scripts/fetch-media.mjs && node scripts/build-media.mjs",
    "fonts": "sh scripts/subset-fonts.sh",
    "setup": "node scripts/setup-local-admin.mjs",
    "content:reset": "node scripts/reset-content.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@astrojs/node": "11.1.7",
    "astro": "7.3.8",
    "compression": "1.8.2",
    "cookie": "2.0.1",
    "motion": "14.1.0",
    "sharp": "0.35.5",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "miniflare": "^4.20260730.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.0",
      "sharp": "^0.35.4"
    }
  }
}
