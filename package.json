{
  "name": "smartup-marketing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "check": "node --check server.mjs && node --check server/assessment.mjs && node --check sites/worker.mjs && node --check scripts/build-sites.mjs && node --check dist/app.js && node --check dist/assessment/engine.js && node --check dist/assessment/assessment.js && node --check dist/assessment/admin/admin.js",
    "test": "node --test tests/*.test.mjs",
    "pretest": "node scripts/build-sites.mjs",
    "build": "npm run build:assets && node scripts/build-sites.mjs",
    "build:assets": "esbuild src/assessment/world.js src/assessment/companion.js --bundle --format=esm --minify --outdir=dist/assessment",
    "setup": "node scripts/setup-local-admin.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "^4.20260730.0"
  },
  "overrides": {"miniflare":{"undici":"^7.29.0","sharp":"^0.35.4"}}
}
