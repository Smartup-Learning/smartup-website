---
import { srcset } from '../lib/media.mjs';
import { getStore } from '../lib/store';
interface Props { base: string; alt: string; sizes: string; priority?: boolean; class?: string }
const { base, alt, sizes, priority = false, class: className } = Astro.props;
// The real size lets the browser reserve the right space before the image arrives.
const size = getStore(Astro.locals).mediaSize(base);
---
<img
  class={className}
  src={`${base}-960.webp`}
  srcset={srcset(base)}
  sizes={sizes}
  alt={alt}
  width={size?.width}
  height={size?.height}
  loading={priority ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={priority ? 'high' : undefined}
  data-priority={priority ? '' : undefined}
/>
