---
import SampleBadge from './SampleBadge.astro';
import { keepTogether } from '../lib/text.mjs';
import { getStore } from '../lib/store';
interface Props { item: { title: string; video: string; poster: string; isSample?: boolean } }
const { item } = Astro.props;
// The poster is a frame from the video, so its shape is the video's shape; tall clips stay tall, wide ones wide.
const size = getStore(Astro.locals).mediaSize(item.poster);
const ratio = size ? size.width / size.height : 9 / 16;
---
<figure class="video-card" data-reveal-item style={`--ratio: ${ratio.toFixed(4)}`}>
  <div class="video-frame">
    <video controls playsinline preload="none" poster={item.poster} data-exclusive aria-label={item.title}>
      <source src={item.video} type="video/mp4" />
    </video>
    <button type="button" class="video-play" data-video-play hidden aria-label={`Play “${item.title}”`}><span aria-hidden="true"></span></button>
  </div>
  <figcaption>{item.isSample && <SampleBadge />} {keepTogether(item.title)}</figcaption>
</figure>
<style>
  .video-card { display: grid; gap: 0.75rem; align-content: start; }
  .video-frame { position: relative; overflow: hidden; aspect-ratio: var(--ratio); border-radius: var(--radius); background: var(--purple-900); }
  /* The frame already has the video's shape, so the picture is never cut, inline or in full screen. */
  video { width: 100%; height: 100%; object-fit: contain; background: #000; }
  video:fullscreen { object-fit: contain; border-radius: 0; }
  video:-webkit-full-screen { object-fit: contain; border-radius: 0; }
  .video-play { position: absolute; inset: 0; display: grid; align-items: end; justify-items: start; padding: 0.7rem; border: 0; background: linear-gradient(transparent 65%, rgb(20 12 32 / 0.4)); cursor: pointer; }
  .video-play[hidden] { display: none; }
  .video-play span { position: relative; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--yellow); box-shadow: 0 4px 14px rgb(20 12 32 / 0.35); }
  .video-play span::after { content: ''; position: absolute; left: 1.05rem; top: 0.8rem; border: 0.575rem solid transparent; border-left: 0.9rem solid var(--ink); border-right: 0; }
  figcaption { font-weight: 600; }
</style>
