---
import Picture from './Picture.astro';
import { getStore } from '../lib/store';
interface Props { base: string; alt: string; sizes: string; ratio?: number; group?: string; caption?: string; priority?: boolean; class?: string }
const { base, alt, sizes, ratio, group, caption, priority = false, class: className } = Astro.props;
const size = getStore(Astro.locals).mediaSize(base);
const natural = size ? size.width / size.height : ratio ?? 4 / 3;
const frame = ratio ?? natural;
// A picture within 20% of the frame's shape fills it (photos). Anything further off, like a poster or a press
// clipping in a landscape frame, is shown whole on a soft, blurred copy of itself instead of being cut.
const fit = Math.abs(Math.log(natural / frame)) > Math.log(1.2) ? 'whole' : 'fill';
const Tag = group ? 'a' : 'div';
const link = group ? { href: `${base}-1600.webp`, 'data-lightbox': group, 'data-caption': caption ?? alt } : {};
---
<Tag class:list={['media-frame', className]} data-fit={fit} style={`--frame-ratio: ${frame.toFixed(4)}`} {...link}>
  {fit === 'whole' && <img class="media-backdrop" src={`${base}-480.webp`} alt="" aria-hidden="true" loading="lazy" decoding="async" width="480" height={Math.round(480 / natural)} />}
  <Picture base={base} alt={alt} sizes={sizes} priority={priority} class="media-img" />
</Tag>
<style>
  .media-frame { position: relative; display: block; overflow: hidden; aspect-ratio: var(--frame-ratio); max-width: 100%; border-radius: var(--radius-sm); background: var(--purple-tint); isolation: isolate; }
  .media-frame :global(.media-img) { position: relative; display: block; width: 100%; height: 100%; object-fit: cover; }
  .media-frame[data-fit='whole'] :global(.media-img) { object-fit: contain; }
  .media-backdrop { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: blur(22px) saturate(1.15); opacity: 0.6; transform: scale(1.2); }
  a.media-frame { cursor: zoom-in; }
  a.media-frame :global(.media-img) { transition: transform 0.5s var(--ease-out); }
  a.media-frame:hover :global(.media-img) { transform: scale(1.02); }
  @media (prefers-reduced-motion: reduce) { a.media-frame:hover :global(.media-img) { transform: none; } }
</style>
