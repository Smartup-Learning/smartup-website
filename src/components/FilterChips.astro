---
interface Props { label: string; target: string; options: { value: string; label: string }[]; allLabel?: string; owner?: 'filters' | 'faq' }
const { label, target, options, allLabel = 'All', owner = 'filters' } = Astro.props;
// Ask Smartup's chips are driven by its search script; every other bar by filters.ts.
const hook = owner === 'faq' ? { 'data-faq-chips': '' } : { 'data-filter-for': target };
---
<div class="chips" role="group" aria-label={label} {...hook} hidden>
  <button type="button" data-filter="all" aria-pressed="true">{allLabel}</button>
  {options.map(o => <button type="button" data-filter={o.value} aria-pressed="false">{o.label}</button>)}
</div>
<style>
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
  /* Phones: one row that scrolls sideways, instead of three or four wrapped rows pushing the content down. */
  @media (max-width: 599px) {
    .chips { flex-wrap: nowrap; overflow-x: auto; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); scrollbar-width: none; }
    .chips::-webkit-scrollbar { display: none; }
    button { flex: none; }
  }
  .chips[hidden] { display: none; }
  button { min-height: 44px; padding: 0.5rem 1.1rem; border: 1px solid var(--line); border-radius: 999px; background: var(--white); font: 600 0.95rem var(--font); color: var(--ink); cursor: pointer; }
  button[aria-pressed='true'] { background: var(--purple); border-color: var(--purple); color: var(--white); }
</style>
