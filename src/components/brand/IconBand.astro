---
import { ICONS } from '../../lib/icons';
// The line-art band from the brand collateral: books, caps, flasks and atoms between small marks.
interface Props { class?: string }
const { class: className } = Astro.props;
const icons = (['book', 'cap', 'atom', 'flask', 'bell', 'pencil', 'bulb', 'globe'] as const).map(name => ICONS[name]);
const marks = ['<path d="M12 8v8M8 12h8"/>', '<path d="M5 12h14"/>', '<path d="M4 14l4-4 4 4 4-4 4 4"/>'];
const row = icons.flatMap((icon, i) => [icon, marks[i % marks.length]]);
---
<div class:list={['icon-band', className]} aria-hidden="true">
  {[0, 1].map(() => (
    <div class="icon-row">
      {row.map((shape, i) => <svg viewBox="0 0 24 24" class:list={[{ mark: i % 2 === 1 }]} set:html={shape} />)}
    </div>
  ))}
</div>
<style>
  .icon-band { display: flex; overflow: hidden; gap: clamp(1rem, 3vw, 2.5rem); color: var(--band-color, var(--purple-300)); mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .icon-row { display: flex; flex: none; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); }
  svg { flex: none; width: clamp(2rem, 1.6rem + 1.5vw, 3rem); height: auto; fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  svg.mark { width: clamp(0.9rem, 0.8rem + 0.5vw, 1.25rem); opacity: 0.7; }
</style>
