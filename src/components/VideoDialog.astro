---
// On phones a tapped YouTube video opens here, as large as the screen allows, instead of inside its small card.
---
<dialog class="video-player" aria-label="Video player">
  <div class="video-player-stage" data-player-stage></div>
  <p class="video-player-title" data-player-title></p>
  <button type="button" class="video-player-close" data-player-close aria-label="Close" autofocus>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
</dialog>
<style>
  .video-player { width: 100vw; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; color: var(--cream); }
  .video-player::backdrop { background: rgb(20 12 32 / 0.96); }
  .video-player[open] { display: grid; place-content: center; justify-items: center; gap: 0.75rem; }
  .video-player-stage { width: 100vw; aspect-ratio: 16 / 9; }
  .video-player[data-format='portrait'] .video-player-stage { width: min(100vw, calc((100dvh - 8rem) * 9 / 16)); aspect-ratio: 9 / 16; }
  .video-player-stage :global(iframe) { width: 100%; height: 100%; border: 0; }
  .video-player-title { padding-inline: 1rem; text-align: center; font-size: var(--step--1); font-weight: 600; }
  .video-player-close { position: absolute; top: max(1rem, env(safe-area-inset-top)); right: 1rem; display: grid; place-items: center; width: 3rem; height: 3rem; border: 1px solid rgb(244 238 228 / 0.35); border-radius: 50%; background: rgb(57 32 100 / 0.6); color: var(--cream); cursor: pointer; }
  .video-player-close svg { width: 1.4rem; height: 1.4rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .video-player :focus-visible { outline-color: var(--cream); }
</style>
