---
import Picture from './Picture.astro';
import { keepTogether } from '../lib/text.mjs';
interface Props { id: string; title: string; format?: 'landscape' | 'portrait'; cover?: string }
const { id, title, format = 'landscape', cover } = Astro.props;
const ratio = format === 'portrait' ? 9 / 16 : 16 / 9;
---
<figure class:list={['yt', `yt--${format}`]} data-yt={id} data-format={format} data-reveal-item style={`--ratio: ${ratio.toFixed(4)}`}>
  <a class="yt-frame" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener" data-yt-title={title}>
    {cover
      ? <Picture base={cover} alt="" sizes={format === 'portrait' ? '(min-width: 900px) 14rem, 55vw' : '(min-width: 900px) 22rem, 82vw'} />
      : <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" />}
    <span class="yt-play" aria-hidden="true"></span>
    <span class="sr-only">Play “{keepTogether(title)}” (YouTube)</span>
  </a>
  <figcaption>{keepTogether(title)}</figcaption>
</figure>
<style>
  .yt { display: grid; gap: 0.6rem; align-content: start; }
  /* :global so the player that replaces the link after a tap (built in youtube.ts) keeps the frame size. */
  .yt :global(.yt-frame) { position: relative; display: block; overflow: hidden; border-radius: var(--radius); background: var(--purple-900); aspect-ratio: var(--ratio); }
  .yt-frame img, .yt :global(.yt-frame iframe) { width: 100%; height: 100%; object-fit: cover; border: 0; }
  .yt-frame img { transition: transform 0.5s var(--ease-out); }
  .yt-frame:hover img { transform: scale(1.03); }
  /* A corner badge, so the play button never covers the subject printed on the thumbnail. */
  .yt-play { position: absolute; left: 0.7rem; bottom: 0.7rem; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--yellow); box-shadow: 0 4px 14px rgb(20 12 32 / 0.35); }
  .yt-play::after { content: ''; position: absolute; left: 1.05rem; top: 0.8rem; border: 0.575rem solid transparent; border-left: 0.9rem solid var(--ink); border-right: 0; }
  figcaption { font-weight: 600; }
  @media (prefers-reduced-motion: reduce) { .yt-frame:hover img { transform: none; } }
</style>
