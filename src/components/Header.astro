---
import { navGroups, quickLinks, isCurrent } from '../lib/nav';
import { formatPhone } from '../../server/content-store.mjs';
import PeekingOwl from './brand/PeekingOwl.astro';
interface Props { path: string; phone?: string | null }
const { path, phone } = Astro.props;
const current = (href: string) => (isCurrent(href, path) ? 'page' : undefined);
const onDemo = path === '/demo';
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo"><img src="/brand/logo.svg" alt="Smartup" width="150" height="33" /></a>
    <a href="/" class="home-link" aria-current={current('/')}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5M5.5 8.6V20a1 1 0 0 0 1 1H10v-6h4v6h3.5a1 1 0 0 0 1-1V8.6"/></svg>
      <span>Home</span>
    </a>
    <nav class="quick" aria-label="Quick links">
      <ul>{quickLinks.map(link => <li><a href={link.href} aria-current={current(link.href)}>{link.label}</a></li>)}</ul>
    </nav>
    {!onDemo && <a class="btn btn--primary header-cta" href="/demo">Find your program</a>}
    <a class="menu-toggle" href="#footer-nav" data-menu-toggle>
      <span class="menu-icon" aria-hidden="true"></span><span data-menu-label>Menu</span>
    </a>
  </div>
  <div id="site-menu" class="menu-panel" hidden>
    <div class="container menu-actions">
      {!onDemo && <a class="btn btn--primary" href="/demo">Find your program</a>}
      {phone && <a class="btn btn--ghost menu-call" href={`tel:${phone}`}>Call {formatPhone(phone)}</a>}
    </div>
    <nav class="container menu-grid" aria-label="Main">
      {navGroups.map(group => (
        <section>
          <h2 class="eyebrow">{group.title}</h2>
          <ul>{group.links.map(link => <li><a href={link.href} aria-current={current(link.href)}>{link.label}</a></li>)}</ul>
        </section>
      ))}
    </nav>
    <PeekingOwl class="menu-owl" wide />
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--white); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 1.25rem; height: var(--header-h); }
  .logo { margin-right: auto; display: block; }
  /* Home is its own link, so nobody has to know that the logo goes home. Phones show the house with its label. */
  .home-link { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 44px; padding-inline: 0.25rem; font-weight: 600; text-decoration: none; }
  .home-link svg { width: 1.35rem; height: 1.35rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .home-link:hover, .home-link[aria-current='page'] { color: var(--purple); }
  @media (max-width: 380px) { .home-link span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } .bar { gap: 0.75rem; } }
  .logo img { width: clamp(118px, 30vw, 150px); height: auto; }
  .quick, .header-cta { display: none; }
  .quick ul { display: flex; gap: 1.5rem; list-style: none; padding: 0; }
  .quick a { position: relative; display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; font-weight: 500; }
  .quick a:hover, .quick a[aria-current='page'] { color: var(--purple); }
  /* The current page is underlined in purple. */
  .quick a[aria-current='page']::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0.45rem; height: 2px; border-radius: 2px; background: var(--purple); }
  .menu-toggle { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; min-width: 44px; padding: 0 0.25rem; font-weight: 600; text-decoration: none; }
  .menu-icon { position: relative; width: 22px; height: 14px; }
  .menu-icon::before, .menu-icon::after { content: ''; position: absolute; left: 0; right: 0; height: 2px; border-radius: 2px; background: currentColor; transition: transform 0.32s var(--ease-out); }
  .menu-icon::before { top: 2px; }
  .menu-icon::after { bottom: 2px; }
  :global(.menu-open) .menu-icon::before { transform: translateY(4px) rotate(45deg); }
  :global(.menu-open) .menu-icon::after { transform: translateY(-4px) rotate(-45deg); }
  .menu-panel { position: fixed; inset: var(--header-h) 0 0; overflow-x: hidden; overflow-y: auto; background: var(--cream); padding-block: 1.5rem 6rem; --peek-bg: var(--white); }
  .menu-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.75rem; }
  .menu-call { color: var(--purple); }
  .menu-grid { position: relative; z-index: 1; display: grid; gap: 1.75rem; }
  .menu-grid ul { list-style: none; padding: 0; margin-top: 0.5rem; display: grid; }
  .menu-grid a { display: flex; align-items: center; min-height: 44px; font-size: var(--step-1); font-weight: 600; text-decoration: none; }
  .menu-grid a:hover, .menu-grid a[aria-current='page'] { color: var(--purple); }
  /* The current page is underlined in purple, like the quick links, without pushing the text sideways. */
  .menu-grid a[aria-current='page'] { text-decoration: underline 3px; text-underline-offset: 0.3em; }
  @media (min-width: 600px) { .menu-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) {
    .quick, .header-cta { display: block; }
    .header-cta { display: inline-flex; min-height: 2.75rem; }
    .menu-panel { padding-block: 2.5rem 4rem; }
    .menu-actions { display: none; }
    .menu-grid { grid-template-columns: repeat(4, 1fr); }
    .menu-grid a { font-size: var(--step-2); }
    .menu-panel :global(.menu-owl) { position: fixed; --peek-size: clamp(16rem, 10rem + 12vw, 26rem); }
  }
</style>
