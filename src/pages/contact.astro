---
import Base from '../layouts/Base.astro';
import { keepTogether } from '../lib/text.mjs';
import PageHero from '../components/PageHero.astro';
import { formatPhone } from '../../server/content-store.mjs';
import { getStore } from '../lib/store';
const store = getStore(Astro.locals);
const settings = store.settings();
const centres = store.centres();
---
<Base title="Centres & contact" description="Smartup centres in Kochi, phone numbers, email and our registered office." page="contact">
  <PageHero eyebrow="Centres & contact" title="Visit us, call us," highlight="ask us anything" intro={centres.length ? `${centres.length} centres across Kochi, all open ${keepTogether(settings.hours)}.` : 'Call or email us, and our team will help.'} />
  {centres.length > 0 && (
  <section class="section" aria-labelledby="centres-title">
    <div class="container">
      <h2 id="centres-title" class="title">Our centres</h2>
      <ul class="centres" data-reveal="group">
        {centres.map(c => (
          <li class="centre" data-reveal-item>
            <h3>{c.name}</h3>
            {c.hours !== settings.hours && <p class="hours">Open {keepTogether(c.hours)}</p>}
            <a class="phone" href={`tel:${c.phone}`}>{formatPhone(c.phone)}</a>
            <a class="link-arrow" href={c.mapUrl} target="_blank" rel="noopener">Directions</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  )}
  <section class="section section--purple" aria-labelledby="reach-title">
    <div class="container reach" data-reveal>
      <div>
        <h2 id="reach-title" class="title">Talk to our team</h2>
        <ul class="lines">
          {settings.phone && <li><span class="line-label">Main line</span><a href={`tel:${settings.phone}`}>{formatPhone(settings.phone)}</a></li>}
          {settings.phones.filter((p: string) => p !== settings.phone).map((p: string) => <li><span class="line-label">Office</span><a href={`tel:${p}`}>{formatPhone(p)}</a></li>)}
          <li><span class="line-label">Email</span><a href={`mailto:${settings.email}`}>{settings.email}</a></li>
          {settings.whatsapp && <li><span class="line-label">WhatsApp</span><a href={`https://wa.me/${settings.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener">Message us</a></li>}
        </ul>
      </div>
      {settings.registeredOffice && (
        <address>
          <strong>{settings.legalName}</strong><br />
          Registered office: {settings.registeredOffice.address}<br />
          <a class="link-arrow" href={settings.registeredOffice.mapUrl} target="_blank" rel="noopener">Open in Maps</a>
        </address>
      )}
    </div>
  </section>
</Base>
<style>
  .title { font-size: var(--step-4); font-weight: 600; margin-bottom: 2rem; }
  .section--purple .title { color: var(--white); }
  .centres { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr); }
  .centre { display: grid; gap: 0.25rem; justify-items: start; padding: 1.25rem 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); }
  h3 { font-size: var(--step-2); font-weight: 600; margin-bottom: 0.25rem; }
  .hours { color: var(--ink-soft); }
  .phone { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--step-1); font-weight: 600; color: var(--purple); text-decoration: none; font-variant-numeric: tabular-nums; }
  .reach { display: grid; gap: 2rem; }
  .lines { list-style: none; padding: 0; display: grid; gap: 0.25rem; font-size: var(--step-1); font-weight: 600; }
  .lines li { display: grid; grid-template-columns: 7rem minmax(0, 1fr); align-items: center; gap: 1rem; }
  .line-label { font-size: var(--step--1); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-purple-soft); }
  .lines a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--white); overflow-wrap: anywhere; }
  .lines a:hover { text-decoration: underline; }
  address { font-style: normal; line-height: 1.7; color: var(--on-purple-soft); }
  address strong { color: var(--white); }
  @media (min-width: 600px) { .centres { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .centres { grid-template-columns: repeat(3, minmax(0, 1fr)); } .reach { grid-template-columns: 1fr 1fr; } }
</style>
