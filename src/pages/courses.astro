---
import Base from '../layouts/Base.astro';
import { keepTogether } from '../lib/text.mjs';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import { BOARDS, formatMinutes, comparisonRows, askLabel, demoLink, isRatio } from '../lib/courses';
import { classesText } from '../../server/forms.mjs';
import IconBand from '../components/brand/IconBand.astro';
import { getStore } from '../lib/store';
const store = getStore(Astro.locals);
const settings = store.settings();
const centres = store.centres();
const programmes = store.programmes();
const cbse = programmes.filter(p => p.board === 'cbse');
const state = programmes.find(p => p.board === 'state');
const rows = comparisonRows(cbse);
const details = settings.courseDetails ?? {};
const list = (value: unknown) => (Array.isArray(value) ? value : []);
const classLengths = list(details.classLengths) as { level: string; minutes: number }[];
const classSteps = list(details.classSteps) as { step: string; minutes: number }[];
const parentUpdates = list(details.parentUpdates) as { name: string; who: string; covers: string[] }[];
const stateSession = list(details.stateSession) as { step: string; minutes: number }[];
const minutesOf = (steps: { minutes: number }[]) => steps.reduce((sum, s) => sum + (Number(s.minutes) || 0), 0);
const mentors = programmes.filter(p => p.mentorRatio);
const stateCards = [
  { title: 'Teaching method', items: list(details.stateMethod) as string[] },
  { title: stateSession.length ? `Each class, about ${formatMinutes(minutesOf(stateSession))}` : 'Each class', items: stateSession.map(s => `${s.step}: ${formatMinutes(s.minutes)}`) },
  { title: 'Daily practice', items: list(details.statePractice) as string[] },
  { title: 'Before the exams', items: list(details.stateExamPrep) as string[] },
].filter(c => c.items.length > 0);
const names = programmes.map(p => p.name.replace(/^Smartup\s+/, '')).join(', ');
const heroPhoto = store.timeline()[0]?.media[0];
---
<Base title="Courses" description={`Smartup programmes for CBSE and Kerala State Board: ${names}, online${centres.length ? ` and at ${centres.length} centres in Kochi` : ''}.`} page="courses">
  <PageHero eyebrow="Courses" title="Programmes built around" highlight="every student" intro={`CBSE and Kerala State Board, ${classesText(settings.classRange)} — online, or at one of our centres in Kochi.`} image={heroPhoto ? { base: heroPhoto.src, alt: heroPhoto.alt, focus: '55% 50%' } : undefined} />

  {cbse.length > 0 && (
    <section class="section" aria-labelledby="cbse-title">
      <div class="container">
        <SectionHead title={BOARDS[0].heading} intro={cbse.length > 1 ? `${['', 'One way', 'Two ways', 'Three ways', 'Four ways', 'Five ways'][cbse.length] ?? `${cbse.length} ways`} to learn, compared line by line.` : undefined} id="cbse-title" />
        <div class="compare-wrap" data-reveal>
          <table class="compare" style={`--cols: ${cbse.length}`}>
            <caption class="sr-only">CBSE programmes compared</caption>
            <thead>
              <tr>
                <td></td>
                {cbse.map(programme => (
                  <th scope="col">
                    {programme.tagline && <span class="col-eyebrow">{programme.tagline}</span>}
                    <span class="col-name">{programme.name}</span>
                    <span class:list={['col-ratio', { 'col-ratio--word': !isRatio(programme.groupSize) }]}>{programme.groupSize}</span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map(row => (
                <tr>
                  <th scope="row">{row.feature}</th>
                  {row.cells.map(cell => <td>{cell === true ? <span class="tick" aria-label="Included">✓</span> : cell === false ? <span class="none" aria-label="Not included">–</span> : keepTogether(cell)}</td>)}
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr><td></td>{cbse.map(programme => <td><a class="link-arrow" href={demoLink(programme.name)}>{askLabel(programme.name)}</a></td>)}</tr>
            </tfoot>
          </table>
        </div>
      </div>
    </section>
  )}

  {(classLengths.length > 0 || classSteps.length > 0) && (
    <section class="section section--cream" aria-labelledby="class-title">
      <div class="container two">
        <div data-reveal>
          <SectionHead title="How long each class is" id="class-title" />
          <table>
            <caption class="sr-only">Class length by level</caption>
            <tbody>{classLengths.map(d => <tr><th scope="row">{d.level}</th><td>{formatMinutes(d.minutes)}</td></tr>)}</tbody>
          </table>
        </div>
        {classSteps.length > 0 && (
          <div data-reveal>
            <h3 class="plan-title">A {formatMinutes(minutesOf(classSteps))} class, step by step</h3>
            <ol class="steps">
              {classSteps.map(s => <li><strong>{s.step}</strong><span>{formatMinutes(s.minutes)}</span></li>)}
            </ol>
          </div>
        )}
      </div>
    </section>
  )}

  {(parentUpdates.length > 0 || mentors.length > 0) && (
    <section class="section" aria-labelledby="parents-title">
      <div class="container">
        <SectionHead eyebrow="For parents" title="You always know how your child is doing" id="parents-title" />
        <div class="updates" data-reveal="group">
          {parentUpdates.map(u => <article class="update" data-reveal-item><h3>{u.name}</h3><p class="who">{u.who}</p><ul>{list(u.covers).map(c => <li>{c}</li>)}</ul></article>)}
          {mentors.length > 0 && <article class="update" data-reveal-item><h3>Mentors</h3><p class="who">Follow-up, attendance, homework, motivation and parent communication</p><ul>{mentors.map(m => <li>{m.name}: {m.mentorRatio}</li>)}</ul></article>}
        </div>
      </div>
    </section>
  )}

  {state && (
    <section class="section section--deep" aria-labelledby="state-title">
      <div class="container">
        <SectionHead title={BOARDS[1].heading} intro={state.features[0]} id="state-title" />
        {state.fee && <p class="state-fee">{keepTogether(state.fee)}</p>}
        <div class="state" data-reveal="group">
          {stateCards.map(card => <article data-reveal-item><h3>{card.title}</h3><ul>{card.items.map(item => <li>{item}</li>)}</ul></article>)}
        </div>
        <a class="btn btn--yellow state-ask" href={demoLink(state.name)}>{askLabel(state.name)}</a>
      </div>
      <IconBand class="courses-band" />
    </section>
  )}

  <section class="section" aria-labelledby="where-title">
    <div class="container where" data-reveal>
      <div class="where-text">
        <SectionHead title={centres.length ? `Learn from home, or at ${centres.length} centres` : 'Learn from home'} intro={centres.length ? `Every centre is open ${keepTogether(settings.hours)}.` : undefined} id="where-title" stack />
        <div class="actions"><a class="btn btn--primary" href="/demo">Book a free demo class</a><a class="link-arrow" href="/contact">Find your nearest centre</a></div>
      </div>
      {centres.length > 0 && <ul class="centre-chips" aria-label="Our centres">{centres.map(c => <li><a href={c.mapUrl} target="_blank" rel="noopener">{c.name}</a></li>)}</ul>}
    </div>
  </section>
</Base>
<style>
  .compare-wrap { overflow-x: auto; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
  .compare { width: 100%; min-width: 34rem; border-collapse: separate; border-spacing: 0; font-size: var(--step--1); }
  .compare th, .compare td { padding: 0.85rem 0.75rem; border-bottom: 1px solid var(--line); text-align: center; vertical-align: middle; }
  .compare tbody th { text-align: left; font-weight: 500; color: var(--ink); width: 40%; }
  .compare thead th { vertical-align: bottom; border-bottom: 2px solid var(--purple); }
  .compare tfoot td { border-bottom: 0; padding-top: 1rem; }
  .col-eyebrow { display: block; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
  .col-name { display: block; font-size: var(--step-2); font-weight: 600; }
  .col-ratio { display: block; font-size: var(--step-1); font-weight: 700; color: var(--purple); }
  .col-ratio--word { font-size: var(--step-0); }
  .state-fee { margin: -1rem 0 1.5rem; font-size: var(--step-1); font-weight: 600; color: var(--yellow); }
  .tick { font-size: var(--step-1); font-weight: 700; color: var(--purple); }
  .none { color: #b9aec7; }
  /* Phones: each feature on its own line with the three values in a row beneath, so nothing scrolls sideways. */
  @media (max-width: 599px) {
    .compare-wrap { overflow: visible; margin-inline: 0; padding-inline: 0; }
    .compare { min-width: 0; }
    .compare thead, .compare tbody, .compare tfoot { display: block; }
    .compare tr { display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); border-bottom: 1px solid var(--line); }
    .compare th, .compare td { border-bottom: 0; padding: 0.55rem 0.35rem; }
    .compare thead tr { border-bottom: 2px solid var(--purple); }
    .compare thead td:first-child, .compare tfoot td:first-child { display: none; }
    .compare thead th { border-bottom: 0; }
    .compare tbody th { grid-column: 1 / -1; width: auto; padding-bottom: 0; font-weight: 600; }
    .col-name { font-size: var(--step-0); }
    .compare tfoot tr { border-bottom: 0; grid-template-columns: 1fr; }
    .compare tfoot td { text-align: left; padding-block: 0; }
  }
  h3 { font-size: var(--step-1); }
  ul { padding-left: 1.1rem; display: grid; gap: 0.3rem; }
  .update ul { color: var(--ink-soft); }
  .two { display: grid; gap: 2rem; }
  table:not(.compare) { width: 100%; border-collapse: collapse; font-size: var(--step-1); }
  table:not(.compare) th, table:not(.compare) td { padding: 0.75rem 0; border-bottom: 1px solid #ddd2c2; text-align: left; }
  table:not(.compare) td { text-align: right; font-weight: 700; color: var(--purple); }
  .plan-title { margin-bottom: 1rem; font-size: var(--step-1); font-weight: 600; }
  .steps { list-style: none; padding: 0; display: grid; gap: 0.75rem; }
  .steps li { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; border-radius: var(--radius-sm); background: var(--white); }
  .updates, .state { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .update { padding: 1.5rem; border-radius: var(--radius); background: var(--cream); display: grid; gap: 0.5rem; align-content: start; }
  .who { font-weight: 600; color: var(--purple); font-size: var(--step--1); }
  .state article { padding: 1.5rem; border-radius: var(--radius); background: var(--purple-600); display: grid; gap: 0.6rem; align-content: start; }
  .state h3 { color: var(--white); }
  .state ul { color: var(--on-purple-soft); }
  .state-ask { margin-top: 2rem; }
  .section--deep { position: relative; overflow: hidden; padding-bottom: 0; --band-color: var(--purple-300); }
  :global(.courses-band) { margin-top: clamp(3rem, 2rem + 3vw, 4.5rem); padding-block: 1.25rem 1.75rem; opacity: 0.5; }
  .where { display: grid; gap: 2rem; align-items: center; }
  .where-text { display: grid; gap: 1.25rem; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .centre-chips { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr)); gap: 0.5rem; }
  .centre-chips a { width: 100%; justify-content: center; }
  .centre-chips a { display: inline-flex; align-items: center; min-height: 44px; padding: 0.4rem 1rem; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-weight: 500; }
  .centre-chips a:hover { border-color: var(--purple); color: var(--purple); }
  @media (min-width: 900px) {
    .two { grid-template-columns: 1fr 1fr; align-items: start; gap: 4rem; }
    .where { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4rem; }
  }
</style>
