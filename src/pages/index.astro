---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import Timeline from '../components/Timeline.astro';
import FounderCard from '../components/FounderCard.astro';
import ResultCard from '../components/ResultCard.astro';
import VideoCard from '../components/VideoCard.astro';
import QuoteCard from '../components/QuoteCard.astro';
import AlumniCard from '../components/AlumniCard.astro';
import CourseTabs from '../components/CourseTabs.astro';
import DemoBand from '../components/DemoBand.astro';
import StoreBadges from '../components/StoreBadges.astro';
import PhoneShot from '../components/PhoneShot.astro';
import { getStore } from '../lib/store';
import { organisationJsonLd } from '../lib/structured-data';
import { siteOrigin } from '../lib/site';
import { classesText } from '../../server/forms.mjs';
const store = getStore(Astro.locals);
const settings = store.settings();
const stats = store.stats();
const chapters = store.timeline({ featured: true });
const leaders = store.leaders();
const results = store.results({ featured: true });
const feedback = store.testimonials('feedback');
const alumni = store.testimonials('alumni');
const alumniStories = store.alumni().slice(0, 3);
const jobs = store.jobs();
const centres = store.centres();
const description = `Smartup tuitions in Kochi and online for CBSE and State Board students, ${classesText(settings.classRange)}. ${stats.map(s => `${s.value} ${s.label.toLowerCase()}`).join(', ')}.`;
---
<Base description={description} page="home" structuredData={organisationJsonLd(settings, centres, siteOrigin(Astro.locals, Astro.url))}>
  <Hero headline={settings.heroHeadline} highlight={settings.heroHighlight} description={settings.heroDescription} image={settings.heroImage || undefined} imageAlt={settings.heroImageAlt} stats={stats} />

  <section id="about" class="section section--cream" aria-labelledby="about-title">
    <div class="container">
      <SectionHead eyebrow="About Smartup" title={settings.aboutTitle} intro={settings.aboutText} id="about-title" />
      {chapters.length > 0 && <Timeline chapters={chapters} variant="teaser" />}
      <p class="more"><a class="link-arrow" href="/story">Read our story</a></p>
    </div>
  </section>

  {leaders.length > 0 && (
    <section id="founders" class="section" aria-labelledby="founders-title">
      <div class="container">
        <SectionHead title="The people behind Smartup" id="founders-title" link={{ href: '/founders', label: 'Meet the founders' }} />
        <div class="founders rail" data-reveal="group">
          {leaders.map(leader => <FounderCard leader={leader} />)}
        </div>
      </div>
    </section>
  )}
  {results.length > 0 && (
    <section id="results" class="section section--cream" aria-labelledby="results-title">
      <div class="container">
        <SectionHead title="Results our students earned" intro="Every figure names its exam and year." id="results-title" link={{ href: '/results', label: 'See all results' }} />
        <div class="rail rail--shapes results-row" data-reveal="group" tabindex="0" role="region" aria-label="Result highlights">
          {results.map(result => <ResultCard result={result} group="home-results" showExam sizes="(min-width: 900px) 18rem, 60vw" />)}
        </div>
      </div>
    </section>
  )}

  {feedback.length > 0 && (
    <section id="feedback" class="section" aria-labelledby="feedback-title">
      <div class="container media-split">
        <SectionHead eyebrow="Student & parent feedback" title="In their own words" intro="Students and parents on what changed after joining Smartup." id="feedback-title" link={{ href: '/testimonials', label: 'More testimonials' }} stack />
        <div class="rail videos" data-reveal="group" tabindex="0" role="region" aria-label="Student and parent feedback">
          {feedback.map(item => item.kind === 'video' ? <VideoCard item={item} /> : <QuoteCard item={item} />)}
        </div>
      </div>
    </section>
  )}

  {(alumni.length > 0 || alumniStories.length > 0) && (
    <section id="alumni" class="section section--deep" aria-labelledby="alumni-title">
      <div class="container">
        <SectionHead eyebrow="Alumni" title="Where Smartup students go" id="alumni-title" link={{ href: '/alumni', label: 'All alumni journeys' }} />
        {alumniStories.length > 0 && (
          <div class="rail alumni-stories" data-reveal="group" tabindex="0" role="region" aria-label="Alumni stories">
            {alumniStories.map(story => <AlumniCard story={story} />)}
          </div>
        )}
        {alumni.length > 0 && (
          <div class="media-split alumni-videos">
            <div class="row-head">
              <h3 class="row-title">Alumni on video</h3>
              <p>Former students back on the Talent Eve stage.</p>
            </div>
            <div class="rail videos" data-reveal="group" tabindex="0" role="region" aria-label="Alumni videos">
              {alumni.map(item => item.kind === 'video' ? <VideoCard item={item} /> : <QuoteCard item={item} />)}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <section id="courses" class="section section--cream" aria-labelledby="courses-title">
    <div class="container">
      <SectionHead title="Programmes for CBSE and State Board" id="courses-title" link={{ href: '/courses', label: 'All course details' }} />
      <CourseTabs programmes={store.programmes()} centreCount={centres.length} hours={settings.hours} />
    </div>
  </section>

  <section id="app" class="section app-section" aria-labelledby="app-title">
    <div class="container">
      <div class="app-panel">
        <div class="app-copy" data-reveal>
          <p class="eyebrow">Smartup App</p>
          <h2 id="app-title">Keep learning after class</h2>
          <p>Smartup Learning puts live classes, recorded lessons, practice questions and progress tracking on your phone.</p>
          <StoreBadges links={settings.appLinks} />
          <a class="link-arrow" href="/app">See inside the app</a>
        </div>
        <div class="app-phones" aria-hidden="true">
          <PhoneShot class="app-phone app-phone--back" file="analysis" alt="" />
          <PhoneShot class="app-phone app-phone--front" file="home" alt="" />
        </div>
      </div>
    </div>
  </section>

  {jobs.length > 0 && (
    <section id="careers" class="careers-band" aria-labelledby="careers-title">
      <div class="container careers-inner">
        <h2 id="careers-title">Teach with Smartup</h2>
        <p>{jobs.length} {jobs.length === 1 ? 'opening' : 'openings'} for teachers, teaching assistants and mentors across our centres.</p>
        <a class="link-arrow" href="/careers">See all {jobs.length} {jobs.length === 1 ? 'opening' : 'openings'}</a>
      </div>
    </section>
  )}

  <DemoBand />
</Base>
<style>
  .more { margin-top: 1.5rem; }
  .videos { grid-auto-columns: min(62%, 15rem); }
  .alumni-stories { grid-auto-columns: min(80%, 20rem); }
  .results-row { gap: 1.5rem; padding-bottom: 1.5rem; }
  .alumni-videos { margin-top: 3.5rem; }
  .row-head { display: grid; gap: 0.5rem; margin-bottom: 1.25rem; }
  .row-head p { color: var(--on-purple-soft); }
  .row-title { font-size: var(--step-2); font-weight: 600; color: var(--white); }
  .careers-band { padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem); border-top: 1px solid var(--line); }
  .careers-inner { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1.5rem; }
  .careers-inner h2 { font-size: var(--step-2); font-weight: 600; }
  .careers-inner p { color: var(--ink-soft); flex: 1 1 20rem; }
  .app-panel { position: relative; overflow: hidden; display: grid; gap: 2rem; padding: clamp(2rem, 1.5rem + 3vw, 4rem) clamp(1.5rem, 1rem + 3vw, 4rem) 0; border-radius: calc(var(--radius) * 1.5); background: radial-gradient(circle at 85% 20%, var(--purple-300), var(--purple) 45%, var(--purple-900)); color: var(--white); }
  .app-copy { display: grid; gap: 1rem; justify-items: start; align-content: center; padding-bottom: 0.5rem; }
  .app-copy .eyebrow { color: var(--yellow); }
  .app-copy h2 { font-size: var(--step-4); font-weight: 600; line-height: 1.05; }
  .app-copy > p:not(.eyebrow) { font-size: var(--step-1); color: var(--on-purple-soft); max-width: 32rem; }
  .app-copy .link-arrow { color: var(--white); }
  /* Two phones rise from the bottom edge of the panel; the back one is tilted. */
  .app-phones { position: relative; height: clamp(14rem, 10rem + 16vw, 20rem); }
  .app-phones :global(.app-phone) { position: absolute; top: 0; width: clamp(10rem, 7rem + 12vw, 15rem); }
  .app-phones :global(.app-phone--front) { left: 8%; z-index: 1; }
  .app-phones :global(.app-phone--back) { right: 6%; top: 2rem; transform: rotate(8deg); opacity: 0.92; }
  @media (min-width: 900px) {
    .app-panel { grid-template-columns: 1.1fr 1fr; padding-bottom: 0; }
    .app-copy { padding-bottom: clamp(2rem, 1.5rem + 3vw, 4rem); }
    .app-phones { height: auto; min-height: 26rem; }
    .app-phones :global(.app-phone) { width: 17rem; top: auto; bottom: -8.5rem; }
    .app-phones :global(.app-phone--front) { left: 4%; }
    .app-phones :global(.app-phone--back) { right: 2%; top: auto; bottom: -11rem; }
  }
  @media (min-width: 900px) {
    .founders { grid-auto-flow: row; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: visible; gap: 1.75rem; }
    .alumni-stories { grid-auto-flow: row; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: visible; gap: 1.5rem; }
  }

</style>
