---
import Base from '../layouts/Base.astro';
import { keepTogether } from '../lib/text.mjs';
import SectionHead from '../components/SectionHead.astro';
import PageHero from '../components/PageHero.astro';
import PeekingOwl from '../components/brand/PeekingOwl.astro';
import Timeline from '../components/Timeline.astro';
import GrowthChart from '../components/GrowthChart.astro';
import FounderCard from '../components/FounderCard.astro';
import TeachBand from '../components/TeachBand.astro';
import { getStore } from '../lib/store';
const store = getStore(Astro.locals);
const chapters = store.timeline();
const leaders = store.leaders();
const openings = store.jobs().length;
const growth = store.growth();
const vision = store.settings().vision;
const first = growth[0];
const latest = growth.at(-1);
const firstYear = Number(chapters[0]?.yearLabel);
// The first chapter's first photo (the 2014 classroom) opens the page.
const heroPhoto = chapters[0]?.media[0];
const journeyTitle = Number.isFinite(firstYear) ? `${new Date().getFullYear() - firstYear} years, year by year` : 'Year by year';
---
<Base title="Our Story" description="How Smartup grew from one classroom in Kochi in 2014 to more than 30,000 students — and where we're going next." page="story">
  <PageHero
    eyebrow="Our Story"
    title={latest ? 'From one classroom to' : 'Our story'}
    highlight={latest ? `${latest.studentsLabel} students` : undefined}
    intro={first && latest ? `Smartup began in ${first.year} with ${first.studentsLabel} students in a single centre in Kochi. Today ${latest.studentsLabel} students have learned with us, online and at ${latest.centres} centres.` : undefined}
    image={heroPhoto ? { base: heroPhoto.src, alt: heroPhoto.alt, focus: '55% 50%', past: chapters.length > 1 } : undefined}
  />

  {chapters.length > 0 && (
    <section class="section" aria-labelledby="journey">
      <div class="container">
        <SectionHead title={journeyTitle} id="journey" />
        <Timeline chapters={chapters} variant="full" />
      </div>
    </section>
  )}

  {growth.length > 0 && (
    <section class="section section--cream" aria-labelledby="growth">
      <div class="container">
        <div class="narrow">
          <SectionHead title="Growth in students and centres" id="growth" />
          <GrowthChart points={growth} />
        </div>
      </div>
    </section>
  )}

  {leaders.length > 0 && (
    <section class="section" aria-labelledby="founders-title">
      <div class="container">
        <SectionHead eyebrow="Founders" title="The people behind Smartup" id="founders-title" link={{ href: '/founders', label: 'Meet the founders' }} />
        <div class="founders rail" data-reveal="group">
          {leaders.map(leader => <FounderCard leader={leader} />)}
        </div>
      </div>
    </section>
  )}

  {/* Short and headline-led (Smartup team, 24 Oct 2026): the title, the tagline and one line per priority. */}
  <section class="section section--purple" aria-labelledby="vision">
    <div class="container">
      <SectionHead eyebrow="Vision for the future" title={vision.title} intro={keepTogether(vision.tagline)} id="vision" />
      <ul class="priorities" data-reveal="group">
        {vision.priorities.map((p: { title: string }) => <li data-reveal-item>{p.title}</li>)}
      </ul>
    </div>
  </section>

  <TeachBand openings={openings} />

  <section class="section story-cta">
    <PeekingOwl class="cta-owl" wide />
    <div class="container cta">
      <h2>See where your story could start</h2>
      <div class="actions"><a class="btn btn--primary" href="/demo">Find your program</a><a class="btn btn--ghost" href="/contact">Connect with us</a></div>
    </div>
  </section>
</Base>
<style>
  .narrow { max-width: 52rem; }
  /* One headline per priority, each with a yellow tick, laid out as a short list rather than paragraphs. */
  .priorities { list-style: none; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: minmax(0, 1fr); }
  .priorities li { display: flex; align-items: center; gap: 0.85rem; padding: 1.1rem 1.4rem; border-radius: var(--radius); background: var(--purple-600); font-size: var(--step-1); font-weight: 600; color: var(--white); line-height: 1.25; }
  .priorities li::before { content: '✓'; flex: none; display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: var(--yellow); color: var(--ink); font-size: 1rem; font-weight: 700; }
  @media (min-width: 700px) { .priorities { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .priorities { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .founders { grid-auto-columns: min(72%, 17rem); }
  @media (min-width: 900px) { .founders { grid-auto-flow: row; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: visible; gap: 1.75rem; } }
  .story-cta { position: relative; overflow: hidden; --peek-bg: var(--purple-tint); }
  .cta { position: relative; z-index: 1; display: grid; gap: 1.5rem; justify-items: start; }
  .cta h2 { font-size: var(--step-4); font-weight: 600; max-width: 30rem; }
  :global(.cta-owl) { --peek-size: clamp(15rem, 8rem + 14vw, 24rem); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
