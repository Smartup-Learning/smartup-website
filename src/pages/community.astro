---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { getStore } from '../lib/store';
const settings = getStore(Astro.locals).settings();
const networkName = { facebook: 'Facebook', instagram: 'Instagram', youtube: 'YouTube', linkedin: 'LinkedIn' } as Record<string, string>;
const accountAbout = {
  'Smartup Educations': 'Results, events, student life and free State Board classes.',
  'Smartup CBSE': 'Classes, tips and updates for CBSE students.',
  'Smartup': 'Company news and teaching careers.',
} as Record<string, string>;
// Labels read "Smartup CBSE on Instagram"; the part before " on " names the account.
const accounts = [...new Set(settings.social.map((s: any) => String(s.label).split(' on ')[0]))].map(name => ({
  name: name as string,
  about: accountAbout[name as string] ?? '',
  links: settings.social.filter((s: any) => String(s.label).split(' on ')[0] === name),
}));
---
<Base title="Community" description="Join the Smartup community on Instagram, YouTube, Facebook and LinkedIn." page="community">
  <PageHero eyebrow="Community" title="Join the Smartup" highlight="community" intro="Follow us for free classes, study tips, results and student life. Enrolled students also get WhatsApp learning groups with notes, MCQs and exam tips." />
  <section class="section" aria-labelledby="channels-title">
    <div class="container layout">
      <h2 id="channels-title" class="sr-only">Our channels</h2>
      <div class="accounts" data-reveal="group">
        {accounts.map(account => (
          <section class="account" data-reveal-item aria-label={account.name}>
            <h3>{account.name}</h3>
            {account.about && <p class="about">{account.about}</p>}
            <ul class="links">
              {account.links.map((s: any) => (
                <li><a class="channel" href={s.url} target="_blank" rel="noopener" aria-label={s.label}><span class="icon"><SocialIcon network={s.network} /></span>{networkName[s.network] ?? s.network}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <aside class="groups" aria-labelledby="groups-title">
        <h3 id="groups-title">WhatsApp learning groups</h3>
        {settings.communityLinks?.length > 0 ? (
          <ul>{settings.communityLinks.map((g: any) => <li><a class="link-arrow" href={g.url} target="_blank" rel="noopener">{g.label}</a></li>)}</ul>
        ) : (
          <p>Enrolled students get notes, MCQs and exam tips in their batch's group. Ask your centre or mentor for the link.</p>
        )}
        <a class="link-arrow" href="/contact">Find your centre</a>
      </aside>
    </div>
  </section>
</Base>
<style>
  .layout { display: grid; gap: 2.5rem; }
  .accounts { display: grid; gap: 1.25rem; }
  .account { display: grid; gap: 0.6rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .account h3 { font-size: var(--step-2); font-weight: 600; }
  .about { color: var(--ink-soft); }
  .links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.4rem; }
  .channel { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; padding: 0.35rem 1.1rem 0.35rem 0.4rem; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-weight: 600; }
  .channel:hover { border-color: var(--purple); color: var(--purple); }
  .icon { display: grid; place-items: center; width: 36px; height: 36px; flex: none; border-radius: 50%; background: var(--purple-tint); color: var(--purple); }
  .groups { display: grid; gap: 0.75rem; align-content: start; justify-items: start; padding: 1.5rem; border-radius: var(--radius); background: var(--purple); color: var(--cream); }
  .groups h3 { font-size: var(--step-2); font-weight: 600; color: var(--white); }
  .groups p { color: var(--on-purple-soft); }
  .groups .link-arrow { color: var(--cream); }
  .groups ul { list-style: none; padding: 0; }
  @media (min-width: 900px) { .layout { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 3rem; align-items: start; } }
</style>
