---
import Base from '../layouts/Base.astro';
import Owl from '../components/Owl.astro';
import { formatPhone } from '../../server/content-store.mjs';
import { getStore } from '../lib/store';
const settings = getStore(Astro.locals).settings();
---
<Base title="Page not found" description="This page of the Smartup website could not be found." page="404">
  <section class="section">
    <div class="container notfound">
      <Owl class="lost-owl" size="clamp(5.5rem, 4rem + 4vw, 8rem)" badge label="Smartup owl looking around" />
      <div class="copy">
        <p class="eyebrow">404</p>
        <h1>This page went on a study tour</h1>
        <p class="text">The link may be old or mistyped. Try one of these instead, or call us and we'll help.</p>
        <div class="actions">
          <a class="btn btn--primary" href="/">Go to the homepage</a>
          <a class="btn btn--ghost" href="/courses">See our courses</a>
          {settings.phone && <a class="link-arrow" href={`tel:${settings.phone}`}>Call {formatPhone(settings.phone)}</a>}
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .notfound { display: grid; gap: 2rem; align-items: start; }
  .copy { display: grid; gap: 1rem; justify-items: start; max-width: 40rem; }
  h1 { font-size: var(--step-4); font-weight: 600; }
  .text { font-size: var(--step-1); color: var(--ink-soft); }
  .actions { display: flex; gap: 0.75rem 1.25rem; flex-wrap: wrap; align-items: center; margin-top: 0.5rem; }
  @media (min-width: 700px) { .notfound { grid-template-columns: auto minmax(0, 1fr); gap: 3rem; } }
</style>
