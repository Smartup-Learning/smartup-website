---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SmartForm from '../components/SmartForm.astro';
import FormField from '../components/FormField.astro';
import { formatPhone } from '../../server/content-store.mjs';
import { getStore } from '../lib/store';
const store = getStore(Astro.locals);
const settings = store.settings();
const jobs = store.jobs();
const types = [...new Set(jobs.map(j => j.type))];
const roles = jobs.map(j => j.title);
const asked = Astro.url.searchParams.get('role') ?? '';
const chosen = roles.includes(asked) ? asked : '';
const error = Astro.url.searchParams.get('error');
---
<Base title="Careers" description="Teach with Smartup: current openings for teachers, teaching assistants, counsellors and mentors in Kochi." page="careers">
  <PageHero eyebrow="Careers" title="Teach with" highlight="Smartup" intro="Join a team of teachers and mentors helping thousands of students across Kochi." />
  <section class="section" aria-label="Current openings">
    <div class="container">
      {jobs.length === 0 && <p class="empty">No openings right now — but we'd still like to hear from you.</p>}
      {types.map(type => (
        <div class="group">
          <h2 class="type">{type}</h2>
          <ul class="jobs" data-reveal="group">
            {jobs.filter(j => j.type === type).map(job => (
              <li class="job" data-reveal-item>
                <div><h3>{job.title}</h3>{job.location && <p class="location">{job.location}</p>}{job.description && <p class="description">{job.description}</p>}</div>
                <a class="link-arrow" href={`/careers?role=${encodeURIComponent(job.title)}#apply`} aria-label={`Apply for ${job.title}`}>Apply</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
  <section class="section apply" id="apply" aria-labelledby="apply-title">
    <div class="container apply-layout">
      <div class="apply-form">
      <h2 id="apply-title" class="apply-title">Apply for a role</h2>
      <SmartForm kind="careers" submit="Send my application" done="Our team will review your application and contact you if there is a match." waText="Hi Smartup, I'm {name}. I just applied for {role}." whatsapp={settings.whatsapp} phone={settings.phone} error={error}>
        <FormField name="name" label="Your name" required maxlength={80} autocomplete="name" minlength={2} invalidMessage="Enter a name (2 to 80 characters)." requiredMessage="Enter your name." />
        <FormField name="phone" label="Mobile number" type="tel" required maxlength={16} autocomplete="tel" inputmode="tel" requiredMessage="Enter a 10-digit Indian mobile number." />
        <FormField name="email" label="Email" type="email" required maxlength={120} autocomplete="email" requiredMessage="Enter your email address." />
        <FormField name="role" label="Role" as="select" required options={[...roles, 'Other']} value={chosen} requiredMessage="Choose a role." />
        <FormField name="experience" label="Teaching experience" maxlength={200} placeholder="e.g. 3 years teaching Physics for Class 11 and 12" />
        <FormField name="cv_url" label="Link to your CV" type="url" maxlength={300} invalidMessage="Use a full link starting with https://" hint="Share a Google Drive or LinkedIn link. We can't accept file uploads." />
        <FormField name="message" label="Message" as="textarea" maxlength={1500} />
      </SmartForm>
      </div>
      <aside class="how" aria-labelledby="how-title">
        <h3 id="how-title">Prefer email?</h3>
        <p>Email your CV to <a href={`mailto:${settings.email}`}>{settings.email}</a> with the role in the subject line{settings.phone && <>, or call <a href={`tel:${settings.phone}`}>{formatPhone(settings.phone)}</a></>}.</p>
      </aside>
    </div>
  </section>
</Base>
<style>
  .group { display: grid; gap: 1rem; margin-bottom: 2.5rem; }
  .type { font-size: var(--step-3); font-weight: 600; color: var(--purple); }
  .jobs { list-style: none; padding: 0; display: grid; gap: 0.75rem; }
  /* Title on the left and "Apply" on the right on every row, whatever the title's length. */
  .job { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 1rem; padding: 1rem 1.25rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .job:hover { border-color: var(--purple-300); }
  h3 { font-size: var(--step-1); font-weight: 600; }
  .description { margin-top: 0.35rem; color: var(--ink-soft); font-size: var(--step--1); white-space: pre-line; }
  .location { color: var(--ink-soft); font-size: var(--step--1); }
  .empty { font-size: var(--step-1); margin-bottom: 2rem; }
  .apply { border-top: 1px solid var(--line); }
  .apply-layout { display: grid; gap: 2.5rem; }
  .apply-form { min-width: 0; }
  .apply-title { font-size: var(--step-3); font-weight: 600; margin-bottom: 1.5rem; }
  .how { display: grid; gap: 0.75rem; align-content: start; padding: 1.5rem; border-radius: var(--radius); background: var(--cream); }
  .how h3 { font-size: var(--step-1); }
  .how a { color: var(--purple); font-weight: 600; }
  @media (min-width: 900px) {
    .jobs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .apply-layout { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 4rem; align-items: start; }
    .how { margin-top: 4.5rem; }
  }
</style>
