---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PeekingOwl from '../components/brand/PeekingOwl.astro';
import { ICONS } from '../lib/icons';
import { getStore } from '../lib/store';
const settings = getStore(Astro.locals).settings();
const features = [
  { icon: ICONS.book, title: 'Notes from every class', text: 'Class notes are shared through the app, so revision starts where the lesson ended.' },
  { icon: ICONS.clock, title: 'Recorded classes', text: 'Catch up on recorded classes within the week, at your own pace.' },
  { icon: ICONS.bulb, title: 'Late Night Express', text: 'Quick revision sessions on the app before board exams.' },
  { icon: ICONS.chart, title: 'AI-integrated learning and LMS', text: 'Tracks practice and progress alongside live classes and daily quizzes.' },
];
const screens = [
  { file: 'home', title: 'Home', text: 'Pick up the last lesson and see how practice is going.' },
  { file: 'courses', title: 'Courses', text: 'CBSE and Kerala State courses for every class.' },
  { file: 'lessons', title: 'Lessons', text: 'Every chapter laid out, with videos and live classes.' },
  { file: 'practice', title: 'Practice', text: 'Short question sets for each topic, plus review and history.' },
  { file: 'analysis', title: 'Analysis', text: 'Effort across videos, live classes and practice, and where you stand.' },
];
---
<Base title="Smartup App" description="The Smartup Learning app: class notes, recorded classes and revision in one place. On Google Play and the App Store." page="app">
  <PageHero eyebrow="Smartup App" title="Your classes, notes and revision" highlight="in one place" intro="Smartup Learning is our AI-integrated learning app and LMS, used by students in every programme." tone="purple">
    <div class="stores">
      {settings.appLinks?.android && (
        <a class="store" href={settings.appLinks.android} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 2.8l10.6 9.2-10.6 9.2c-.3-.2-.5-.6-.5-1V3.8c0-.4.2-.8.5-1z" fill="#2fd27b" /><path d="M15.1 12l3.3 2.9-11.8 6.8c-.6.3-1.3.2-2.1-.5z" fill="#ff4f5e" /><path d="M15.1 12L4.5 2.8c.8-.7 1.5-.8 2.1-.5l11.8 6.8z" fill="#28b6f6" /><path d="M18.4 9.1l2.6 1.5c1 .6 1 2.2 0 2.8l-2.6 1.5-3.3-2.9z" fill="#ffc533" /></svg>
          <span><small>Get it on</small>Google Play</span>
        </a>
      )}
      {settings.appLinks?.ios && (
        <a class="store" href={settings.appLinks.ios} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.8-.8-3-.8-1.5 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.2.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.2 0 2-1.1 2.8-2.2.9-1.3 1.2-2.5 1.2-2.6 0 0-2.4-.9-2.4-3.8zM14.1 5.8c.6-.8 1.1-1.9 1-2.9-.9 0-2.1.6-2.7 1.4-.6.7-1.1 1.8-1 2.8 1 .1 2.1-.5 2.7-1.3z" /></svg>
          <span><small>Download on the</small>App Store</span>
        </a>
      )}
    </div>
    <div class="phone" slot="visual">
      <img class="screen" src="/app/home.webp" width="480" height="1019" alt="The Smartup Learning app home screen" fetchpriority="high" />
    </div>
  </PageHero>
  <section class="section" aria-labelledby="features-title">
    <div class="container">
      <h2 id="features-title" class="title">What students use it for</h2>
      <ul class="features" data-reveal="group">
        {features.map(f => <li data-reveal-item><svg viewBox="0 0 24 24" aria-hidden="true" set:html={f.icon} /><h3>{f.title}</h3><p>{f.text}</p></li>)}
      </ul>
    </div>
  </section>
  <section class="section section--cream" aria-labelledby="inside-title">
    <div class="container">
      <h2 id="inside-title" class="title">Inside the app</h2>
      <ul class="rail shots" data-reveal="group" tabindex="0" aria-label="App screens">
        {screens.map(s => (
          <li data-reveal-item>
            <div class="phone phone--flat"><img class="screen" src={`/app/${s.file}.webp`} width="480" height="1019" alt={`The ${s.title} screen of the Smartup Learning app`} loading="lazy" /></div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section section--purple quest-band">
    <PeekingOwl class="quest-owl" />
    <div class="container">
      <div class="quest" data-reveal>
        <p class="eyebrow">Free for students</p>
        <h2>Try Smartup Quest</h2>
        <p>A free learning challenge for Classes 5 to 10 that shows where your child stands in each subject.</p>
        <a class="btn btn--yellow" href="/assessment/">Start Smartup Quest</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .stores { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
  /* Store badges in the familiar black style, Google Play first since most families here use Android. */
  .store { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 3.25rem; padding: 0.45rem 1.1rem 0.45rem 0.85rem; border: 1px solid rgb(255 255 255 / 0.35); border-radius: 0.7rem; background: #111; color: var(--white); text-decoration: none; font-weight: 600; font-size: 1.15rem; line-height: 1.05; }
  .store:hover { background: #000; }
  .store svg { width: 1.75rem; height: 1.75rem; flex: none; }
  .store span { display: grid; }
  .store small { font-size: 0.68rem; font-weight: 500; letter-spacing: 0.02em; text-transform: uppercase; opacity: 0.85; }
  .phone { width: 15rem; aspect-ratio: 9 / 19; padding: 0.7rem; border-radius: 2.4rem; background: #17101f; box-shadow: 0 30px 60px -25px rgb(0 0 0 / 0.6), inset 0 0 0 2px rgb(255 255 255 / 0.12); transform: rotate(-6deg); }
  .screen { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 1.8rem; background: var(--white); }
  .phone--flat { width: 100%; padding: 0.5rem; border-radius: 1.9rem; transform: none; box-shadow: 0 20px 40px -24px rgb(23 16 31 / 0.55); }
  .phone--flat .screen { border-radius: 1.45rem; }
  .shots { list-style: none; padding-top: 0.5rem; grid-auto-columns: min(62%, 15rem); }
  .shots li { display: grid; gap: 0.4rem; align-content: start; }
  .shots h3 { margin-top: 0.75rem; font-size: var(--step-1); }
  .shots p { color: var(--ink-soft); }
  /* Wide screens: all five phones side by side, no scrolling. */
  @media (min-width: 900px) { .shots { grid-auto-flow: row; grid-template-columns: repeat(5, 1fr); overflow: visible; margin-inline: 0; padding-inline: 0; } }
  .title { font-size: var(--step-4); font-weight: 600; margin-bottom: 2rem; }
  .features { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .features li { padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); display: grid; gap: 0.5rem; align-content: start; }
  .features svg { width: 2.25rem; height: 2.25rem; margin-bottom: 0.25rem; fill: none; stroke: var(--purple); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .features h3 { font-size: var(--step-1); }
  .features p { color: var(--ink-soft); }
  .quest-band { position: relative; overflow: hidden; --peek-bg: var(--cream); }
  .quest { position: relative; z-index: 1; display: grid; gap: 1rem; justify-items: start; max-width: 40rem; }
  .quest h2 { font-size: var(--step-4); font-weight: 600; color: var(--white); }
  .quest > p:not(.eyebrow) { font-size: var(--step-1); color: var(--on-purple-soft); }
  :global(.quest-owl) { --peek-size: 10rem; }
  @media (min-width: 900px) { :global(.quest-owl) { --peek-size: clamp(15rem, 8rem + 14vw, 24rem); } }
</style>
